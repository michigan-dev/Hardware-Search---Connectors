# Distributor credentials. Every one is optional: with none set, the page still
# works and each vendor card falls back to a search link.

# Mouser Search API key (https://www.mouser.com/api-hub/)
MOUSER_API_KEY=

# DigiKey Product Information v4 app (https://developer.digikey.com/)
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Optional: point DigiKey at the sandbox host instead of production
# DIGIKEY_API_BASE=https://sandbox-api.digikey.com

# Node host only
PORT=8787
